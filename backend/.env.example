# Pixeo backend — exemple de configuration locale
# Copier ce fichier vers backend/.env puis adapter les valeurs.
# Ne jamais committer backend/.env.

# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-local-development-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.lvh.me,.pixeo.localhost

# ─── Domaines Pixeo ───────────────────────────────────────────────────────────
# Base utilisée pour résoudre le tenant : {username}.{PIXEO_BASE_DOMAIN}
PIXEO_BASE_DOMAIN=lvh.me
PIXEO_PUBLIC_SCHEME=http

# URLs des applications (développement local)
PIXEO_APP_URL=http://app.lvh.me:3000
PIXEO_ADMIN_URL=http://admin.lvh.me:3000
PIXEO_API_URL=http://api.lvh.me:8000

# ─── Base de données ──────────────────────────────────────────────────────────
# SQLite autorisé uniquement en développement. PostgreSQL en production.
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://pixeo:pixeo@localhost:5432/pixeo

# ─── CORS / CSRF ──────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://app.lvh.me:3000,http://admin.lvh.me:3000,http://yves.lvh.me:3000
CSRF_TRUSTED_ORIGINS=http://app.lvh.me:3000,http://admin.lvh.me:3000,http://api.lvh.me:8000

# ─── Authentification (JWT + cookie refresh) ──────────────────────────────────
AUTH_REFRESH_COOKIE_NAME=pixeo_refresh
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_ACCESS_TOKEN_LIFETIME_MINUTES=15
AUTH_REFRESH_TOKEN_LIFETIME_DAYS=14

# ─── Stockage ─────────────────────────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
MEDIA_ROOT=media
MEDIA_URL=/media/

# S3 / Cloudflare R2 (production)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=pixeo-photos
S3_REGION=auto
S3_PUBLIC_URL=
S3_USE_PRESIGNED_URLS=True

# ─── Cache / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Email ────────────────────────────────────────────────────────────────────
# En développement : les emails sont affichés dans la console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@pixeo.test

# ─── Sécurité (production) ────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
