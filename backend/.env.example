# Pixeo backend — exemple de configuration locale
# Copier ce fichier vers backend/.env puis adapter les valeurs.
# Ne jamais committer backend/.env.

# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-local-development-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.lvh.me,.pixeo.localhost
DJANGO_LOG_LEVEL=DEBUG
# Production (exemples) :
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=api.pixeo.com,app.pixeo.com,admin.pixeo.com,.pixeo.com
# DJANGO_LOG_LEVEL=INFO

# ─── Domaines Pixeo ───────────────────────────────────────────────────────────
# Base utilisée pour résoudre le tenant : {username}.{PIXEO_BASE_DOMAIN}
PIXEO_BASE_DOMAIN=lvh.me
PIXEO_PUBLIC_SCHEME=http

# URLs des applications (développement local)
PIXEO_APP_URL=http://app.lvh.me:3000
PIXEO_ADMIN_URL=http://admin.lvh.me:3000
PIXEO_API_URL=http://api.lvh.me:8000

# ─── PostgreSQL local (Docker Compose) ───────────────────────────────────────
# Ces variables sont lues par backend/docker-compose.yml.
# Générer un mot de passe fort et le placer uniquement dans backend/.env.
POSTGRES_DB=pixeo
POSTGRES_USER=pixeo
POSTGRES_PASSWORD=change-me-in-local-development-only
POSTGRES_PORT=5432

# ─── Base de données Django ───────────────────────────────────────────────────
# PostgreSQL est la base de développement et de production.
# Le mot de passe de DATABASE_URL doit correspondre à POSTGRES_PASSWORD.
# Encoder les caractères spéciaux du mot de passe dans l'URL si nécessaire.
DATABASE_URL=postgresql://pixeo:change-me-in-local-development-only@127.0.0.1:5432/pixeo
DATABASE_CONN_MAX_AGE=60
# Production :
# DATABASE_URL=postgresql://pixeo:mot-de-passe@localhost:5432/pixeo
# DATABASE_CONN_MAX_AGE=600
# Tests unitaires isolés possibles avec :
# DATABASE_URL=sqlite:///:memory:

# ─── CORS / CSRF ──────────────────────────────────────────────────────────────
# CORS et CSRF sont distincts. Aucun wildcard global CORS n'est activé.
CORS_ALLOWED_ORIGINS=http://app.lvh.me:3000,http://admin.lvh.me:3000,http://yves.lvh.me:3000
CORS_ALLOWED_ORIGIN_REGEXES=^http://[a-z0-9-]+\.lvh\.me:3000$
CSRF_TRUSTED_ORIGINS=http://app.lvh.me:3000,http://admin.lvh.me:3000,http://api.lvh.me:8000,http://*.lvh.me:3000
# Production (exemples) :
# CORS_ALLOWED_ORIGINS=https://app.pixeo.com,https://admin.pixeo.com
# CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+\.pixeo\.com$
# CSRF_TRUSTED_ORIGINS=https://app.pixeo.com,https://admin.pixeo.com,https://*.pixeo.com

# ─── Authentification (JWT + cookie refresh) ──────────────────────────────────
AUTH_REFRESH_COOKIE_NAME=pixeo_refresh
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_ACCESS_TOKEN_LIFETIME_MINUTES=15
AUTH_REFRESH_TOKEN_LIFETIME_DAYS=14
# Laisser vide pour un cookie host-only. La stratégie inter-sous-domaines
# sera décidée et testée aux lots C2/C3.
AUTH_REFRESH_COOKIE_DOMAIN=

# ─── Stockage ─────────────────────────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
MEDIA_ROOT=media
MEDIA_URL=/media/

# S3 / Cloudflare R2 (production)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=pixeo-photos
S3_REGION=auto
S3_PUBLIC_URL=
S3_USE_PRESIGNED_URLS=True

# ─── Cache / Celery ───────────────────────────────────────────────────────────
# Redis est optionnel en A2. Laisser CACHE_URL vide pour utiliser le cache local.
REDIS_URL=redis://localhost:6379/0
CACHE_URL=
# CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Email ────────────────────────────────────────────────────────────────────
# En développement : les emails sont affichés dans la console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@pixeo.test

# ─── Sécurité (production) ────────────────────────────────────────────────────
# En développement, ces valeurs restent à False.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax
# Laisser vide pour des cookies host-only. Stratégie C2/C3.
CSRF_COOKIE_DOMAIN=
SESSION_COOKIE_DOMAIN=
# Production (exemples) :
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
