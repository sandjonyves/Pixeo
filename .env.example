# Public app URL (used for share links, emails, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Object storage — Cloudflare R2 (or swap for B2_* below)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pixeo-photos
R2_PUBLIC_URL=https://photos.yourdomain.com

# Backblaze B2 alternative
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=pixeo-photos
# B2_ENDPOINT=

# Stripe (future billing)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
